{
  "name": "@autospokes/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma && tsx watch src/server.ts",
    "build": "node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma && tsc -p tsconfig.json",
    "prisma:generate": "node node_modules/prisma/build/index.js generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy --schema prisma/schema.prisma",
    "db:verify": "tsx scripts/verify-database.ts",
    "bootstrap:superadmin": "tsx scripts/bootstrap-superadmin.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@autospokes/shared": "0.1.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^11.3.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^10.2.4",
    "@fastify/rate-limit": "^10.3.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "6.12.0",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "prisma": "6.12.0",
    "tsx": "^4.19.3"
  }
}
