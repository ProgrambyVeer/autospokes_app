HOST=127.0.0.1
PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://autospokes_app:replace-with-local-password@127.0.0.1:5432/autospokes_dev?schema=public
JWT_SECRET=
BOOTSTRAP_SUPERADMIN_EMAIL=
BOOTSTRAP_SUPERADMIN_PASSWORD=
BOOTSTRAP_SUPERADMIN_DISPLAY_NAME=
ALLOW_PRODUCTION_SUPERADMIN_BOOTSTRAP=false
# Exact origins only. Development accepts local origins; production requires explicit HTTPS origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5180,http://127.0.0.1:5180
# Comma-separated trusted proxy IPs/CIDRs. Leave empty unless the API is behind known, network-restricted proxies.
TRUSTED_PROXY_ADDRESSES=
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=5
AUTH_RATE_LIMIT_WINDOW_MS=900000
# Limits are in-memory per API process; coordinate them at the hosting layer before scaling out.
