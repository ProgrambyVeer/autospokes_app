generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  INDEPENDENT_DETAILER
  SOCIETY_VENDOR
  MARKETPLACE_VENDOR
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum VehicleType {
  TWO_WHEELER
  FOUR_WHEELER
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum VehicleProviderType {
  INDEPENDENT_WASHER
  SOCIETY_VENDOR
  MARKETPLACE_VENDOR
}

enum WashActivity {
  EXTERIOR_WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum TaskActivity {
  DUSTING
  EXTERIOR_WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum ScheduleFrequency {
  DAILY
  SELECTED_DAYS
}

enum DailyTaskStatus {
  SCHEDULED
  COMPLETED
  MISSED
  UNAVAILABLE
}

enum DailyTaskException {
  VEHICLE_UNAVAILABLE
  WASH_MISSED
  DETAILER_ON_LEAVE
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  passwordHash String        @db.VarChar(255)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  account      Account?      @relation("AccountOwner")
  profiles     RoleProfile[]
  sessions     Session[]
  auditEvents  AuditEvent[]  @relation("AuditActor")
}

model Account {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  ownerId     String        @unique @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  owner       User          @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profiles    RoleProfile[]
  sessions    Session[]
  auditEvents AuditEvent[]
  vehicles    Vehicle[]
  detailerClients  DetailerClient[]
  detailerVehicles DetailerVehicle[]
  washSchedules    WashSchedule[]
  dailyTasks       DailyTask[]
}

model Vehicle {
  id                          String              @id @default(uuid()) @db.Uuid
  accountId                   String              @db.Uuid
  type                        VehicleType
  registrationNumber          String              @db.VarChar(32)
  registrationNumberNormalized String             @unique @db.VarChar(32)
  make                        String?             @db.VarChar(80)
  model                       String?             @db.VarChar(80)
  lengthCm                    Float?
  widthCm                     Float?
  heightCm                    Float?
  photoUrls                   String[]            @default([])
  locationName                String?             @db.VarChar(100)
  address                     String?             @db.VarChar(240)
  city                        String?             @db.VarChar(100)
  postalCode                  String?             @db.VarChar(24)
  providerType                VehicleProviderType?
  providerName                String?             @db.VarChar(120)
  assignedWasherName          String?             @db.VarChar(120)
  status                      VehicleStatus       @default(ACTIVE)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(6)
  account                     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([id, accountId])
  @@index([accountId, status, createdAt])
}

model DetailerClient {
  id          String            @id @default(uuid()) @db.Uuid
  accountId   String            @db.Uuid
  name        String            @db.VarChar(100)
  phoneNumber String            @db.VarChar(16)
  notes       String?           @db.VarChar(500)
  status      VehicleStatus     @default(ACTIVE)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicles    DetailerVehicle[]

  @@unique([accountId, phoneNumber])
  @@unique([id, accountId])
  @@index([accountId, status, name])
}

model DetailerVehicle {
  id                           String          @id @default(uuid()) @db.Uuid
  accountId                    String          @db.Uuid
  clientId                     String          @db.Uuid
  type                         VehicleType
  registrationNumber           String          @db.VarChar(32)
  registrationNumberNormalized String          @db.VarChar(32)
  make                         String?         @db.VarChar(80)
  model                        String?         @db.VarChar(80)
  locationName                 String?         @db.VarChar(100)
  status                       VehicleStatus   @default(ACTIVE)
  createdAt                    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime        @updatedAt @db.Timestamptz(6)
  account                      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client                       DetailerClient  @relation(fields: [clientId, accountId], references: [id, accountId], onDelete: NoAction)
  schedules                    WashSchedule[]
  tasks                        DailyTask[]

  @@unique([accountId, registrationNumberNormalized])
  @@unique([id, accountId])
  @@index([clientId, accountId])
  @@index([accountId, status])
}

model WashSchedule {
  id              String            @id @default(uuid()) @db.Uuid
  accountId       String            @db.Uuid
  vehicleId       String            @db.Uuid
  activity        WashActivity
  taskActivityKey TaskActivity
  frequency       ScheduleFrequency
  weekdays        Int[]             @default([])
  effectiveFrom   DateTime          @db.Date
  effectiveTo     DateTime?         @db.Date
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicle         DetailerVehicle   @relation(fields: [vehicleId, accountId], references: [id, accountId], onDelete: NoAction)
  tasks           DailyTask[]

  @@unique([vehicleId, activity])
  @@unique([id, accountId])
  @@unique([id, accountId, vehicleId, taskActivityKey])
  @@index([accountId, isActive])
}

model DailyTask {
  id          String             @id @default(uuid()) @db.Uuid
  accountId   String             @db.Uuid
  vehicleId   String             @db.Uuid
  scheduleId  String?            @db.Uuid
  activity    TaskActivity
  taskDate    DateTime           @db.Date
  status      DailyTaskStatus    @default(SCHEDULED)
  exception   DailyTaskException?
  completedAt DateTime?          @db.Timestamptz(6)
  note        String?            @db.VarChar(500)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicle     DetailerVehicle    @relation(fields: [vehicleId, accountId], references: [id, accountId], onDelete: NoAction)
  schedule    WashSchedule?      @relation(fields: [scheduleId, accountId, vehicleId, activity], references: [id, accountId, vehicleId, taskActivityKey], onDelete: NoAction)

  @@unique([vehicleId, taskDate, activity])
  @@index([accountId, taskDate])
}

model RoleProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  accountId   String?   @db.Uuid
  role        UserRole
  displayName String    @db.VarChar(80)
  profileData Json      @default("{}")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([id, userId])
  @@unique([userId, role])
  @@index([accountId, role])
}

model Session {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  roleProfileId    String      @db.Uuid
  accountId        String?     @db.Uuid
  refreshTokenHash String      @unique @db.Char(64)
  expiresAt        DateTime    @db.Timestamptz(6)
  revokedAt        DateTime?   @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleProfile      RoleProfile @relation(fields: [roleProfileId, userId], references: [id, userId], onDelete: Cascade)
  account          Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([accountId])
  @@index([expiresAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  accountId String?  @db.Uuid
  action    String   @db.VarChar(80)
  details   Json?
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
