generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  INDEPENDENT_DETAILER
  SOCIETY_VENDOR
  MARKETPLACE_VENDOR
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum VehicleType {
  TWO_WHEELER
  FOUR_WHEELER
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum VehicleProviderType {
  INDEPENDENT_WASHER
  SOCIETY_VENDOR
  MARKETPLACE_VENDOR
}

enum WashActivity {
  EXTERIOR_WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum TaskActivity {
  DUSTING
  EXTERIOR_WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum ScheduleFrequency {
  DAILY
  SELECTED_DAYS
}

enum DailyTaskStatus {
  SCHEDULED
  COMPLETED
  MISSED
  UNAVAILABLE
}

enum DailyTaskException {
  VEHICLE_UNAVAILABLE
  WASH_MISSED
  DETAILER_ON_LEAVE
}

enum SocietyStatus {
  ACTIVE
  INACTIVE
}

enum SocietyWasherStatus {
  ACTIVE
  INACTIVE
}

enum SocietyAttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum SocietyTaskActivity {
  WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum SocietyWashScheduleStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum SocietyTaskStatus {
  SCHEDULED
  COMPLETED
  MISSED
  UNAVAILABLE
}

enum SocietyInvoiceStatus {
  ISSUED
  VOID
}

enum SocietyPaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum SocietyDeductionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SocietyExtraWorkStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MarketplaceCategory {
  GARAGE
  DETAILING_CENTRE
  MOBILE_DETAILER
  OTHER
}

enum MarketplaceServiceCategory {
  EXTERIOR_WASH
  INTERIOR_CLEANING
  DETAILING
  POLISH_AND_COATING
  PERIODIC_SERVICE
  REPAIR
  TYRE_AND_WHEEL
  OTHER
}

enum MarketplaceVerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum MarketplaceServiceStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum MarketplaceBookingStatus {
  REQUESTED
  ACCEPTED
  REJECTED
  IN_PROGRESS
  PROVIDER_REPORTED_COMPLETION
  CUSTOMER_ACCEPTED
  DISPUTED
  SETTLED
  CLOSED
  CANCELLED
}

enum MarketplacePaymentStatus {
  RECORDED_UNVERIFIED
  VERIFIED
  FAILED
  REFUNDED
}

enum MarketplaceDisputeStatus {
  OPEN
  RESPONDED
  RESOLVED
  WITHDRAWN
}

enum MarketplaceDisputeOutcome {
  UPHELD_COMPLETION
  REWORK_REQUIRED
  CANCELLED_NO_CHARGE
}

enum MarketplaceDisputeEntryKind {
  OPENED
  VENDOR_RESPONSE
  RESOLVED
  WITHDRAWN
}

enum MarketplaceRefundStatus {
  APPROVED_PENDING_EXTERNAL_TRANSFER
  CONFIRMED_EXTERNALLY
}

enum MarketplaceCancellationKind {
  OWNER_CANCELLED
  VENDOR_CANCELLED
  OWNER_NO_SHOW
  VENDOR_NO_SHOW
  DISPUTE_RESOLUTION
}

enum MarketplacePaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CARD
  OTHER
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  passwordHash String        @db.VarChar(255)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  account      Account?      @relation("AccountOwner")
  profiles     RoleProfile[]
  sessions     Session[]
  auditEvents  AuditEvent[]  @relation("AuditActor")
}

model Account {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  ownerId     String        @unique @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  owner       User          @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profiles    RoleProfile[]
  sessions    Session[]
  auditEvents AuditEvent[]
  vehicles    Vehicle[]
  detailerClients  DetailerClient[]
  detailerVehicles DetailerVehicle[]
  washSchedules    WashSchedule[]
  dailyTasks       DailyTask[]
  societies        Society[]
  societyResidents SocietyResident[]
  societyVehicles  SocietyVehicle[]
  societyWashers   SocietyWasher[]
  societyAssignments SocietyWasherAssignment[]
  societyWashSchedules SocietyWashSchedule[]
  societyAttendance SocietyAttendance[]
  societyTasks     SocietyWashTask[]
  societyInvoices SocietyInvoice[]
  societyPayments SocietyPayment[]
  societyReminders SocietyPaymentReminder[]
  societyDeductions SocietyWasherDeduction[]
  societyExtraWork SocietyExtraWork[]
  marketplaceProfile MarketplaceProfile?
  marketplaceServices MarketplaceService[]
  marketplaceStaff MarketplaceStaff[]
  marketplaceBookingsAsOwner MarketplaceBooking[] @relation("MarketplaceBookingOwner")
  marketplaceBookingsAsVendor MarketplaceBooking[] @relation("MarketplaceBookingVendor")
}

model Vehicle {
  id                          String              @id @default(uuid()) @db.Uuid
  accountId                   String              @db.Uuid
  type                        VehicleType
  registrationNumber          String              @db.VarChar(32)
  registrationNumberNormalized String             @unique @db.VarChar(32)
  make                        String?             @db.VarChar(80)
  model                       String?             @db.VarChar(80)
  lengthCm                    Float?
  widthCm                     Float?
  heightCm                    Float?
  photoUrls                   String[]            @default([])
  locationName                String?             @db.VarChar(100)
  address                     String?             @db.VarChar(240)
  city                        String?             @db.VarChar(100)
  postalCode                  String?             @db.VarChar(24)
  providerType                VehicleProviderType?
  providerName                String?             @db.VarChar(120)
  assignedWasherName          String?             @db.VarChar(120)
  status                      VehicleStatus       @default(ACTIVE)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(6)
  account                     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  marketplaceBookings         MarketplaceBooking[]

  @@unique([id, accountId])
  @@index([accountId, status, createdAt])
}

model DetailerClient {
  id          String            @id @default(uuid()) @db.Uuid
  accountId   String            @db.Uuid
  name        String            @db.VarChar(100)
  phoneNumber String            @db.VarChar(16)
  notes       String?           @db.VarChar(500)
  status      VehicleStatus     @default(ACTIVE)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicles    DetailerVehicle[]

  @@unique([accountId, phoneNumber])
  @@unique([id, accountId])
  @@index([accountId, status, name])
}

model DetailerVehicle {
  id                           String          @id @default(uuid()) @db.Uuid
  accountId                    String          @db.Uuid
  clientId                     String          @db.Uuid
  type                         VehicleType
  registrationNumber           String          @db.VarChar(32)
  registrationNumberNormalized String          @db.VarChar(32)
  make                         String?         @db.VarChar(80)
  model                        String?         @db.VarChar(80)
  locationName                 String?         @db.VarChar(100)
  status                       VehicleStatus   @default(ACTIVE)
  createdAt                    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime        @updatedAt @db.Timestamptz(6)
  account                      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client                       DetailerClient  @relation(fields: [clientId, accountId], references: [id, accountId], onDelete: NoAction)
  schedules                    WashSchedule[]
  tasks                        DailyTask[]

  @@unique([accountId, registrationNumberNormalized])
  @@unique([id, accountId])
  @@index([clientId, accountId])
  @@index([accountId, status])
}

model WashSchedule {
  id              String            @id @default(uuid()) @db.Uuid
  accountId       String            @db.Uuid
  vehicleId       String            @db.Uuid
  activity        WashActivity
  taskActivityKey TaskActivity
  frequency       ScheduleFrequency
  weekdays        Int[]             @default([])
  effectiveFrom   DateTime          @db.Date
  effectiveTo     DateTime?         @db.Date
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicle         DetailerVehicle   @relation(fields: [vehicleId, accountId], references: [id, accountId], onDelete: NoAction)
  tasks           DailyTask[]

  @@unique([vehicleId, activity])
  @@unique([id, accountId])
  @@unique([id, accountId, vehicleId, taskActivityKey])
  @@index([accountId, isActive])
}

model DailyTask {
  id          String             @id @default(uuid()) @db.Uuid
  accountId   String             @db.Uuid
  vehicleId   String             @db.Uuid
  scheduleId  String?            @db.Uuid
  activity    TaskActivity
  taskDate    DateTime           @db.Date
  status      DailyTaskStatus    @default(SCHEDULED)
  exception   DailyTaskException?
  completedAt DateTime?          @db.Timestamptz(6)
  note        String?            @db.VarChar(500)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicle     DetailerVehicle    @relation(fields: [vehicleId, accountId], references: [id, accountId], onDelete: NoAction)
  schedule    WashSchedule?      @relation(fields: [scheduleId, accountId, vehicleId, activity], references: [id, accountId, vehicleId, taskActivityKey], onDelete: NoAction)

  @@unique([vehicleId, taskDate, activity])
  @@index([accountId, taskDate])
}

model Society {
  id        String        @id @default(uuid()) @db.Uuid
  accountId String        @db.Uuid
  name      String        @db.VarChar(120)
  address   String?       @db.VarChar(240)
  status    SocietyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  residents SocietyResident[]
  vehicles  SocietyVehicle[]
  washers   SocietyWasher[]
  assignments SocietyWasherAssignment[]
  schedules   SocietyWashSchedule[]
  attendance SocietyAttendance[]
  tasks     SocietyWashTask[]
  invoices  SocietyInvoice[]
  deductions SocietyWasherDeduction[]
  extraWork SocietyExtraWork[]

  @@unique([id, accountId])
  @@index([accountId, status, name])
}

model SocietyResident {
  id          String          @id @default(uuid()) @db.Uuid
  accountId   String          @db.Uuid
  societyId   String          @db.Uuid
  name        String          @db.VarChar(100)
  phoneNumber String          @db.VarChar(16)
  unit        String?         @db.VarChar(40)
  email       String?         @db.VarChar(254)
  status      VehicleStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society     Society         @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicles    SocietyVehicle[]
  invoices    SocietyInvoice[]
  extraWork   SocietyExtraWork[]

  @@unique([id, accountId])
  @@unique([id, societyId, accountId])
  @@unique([societyId, accountId, phoneNumber])
  @@index([accountId, societyId, status, name])
}

model SocietyWasher {
  id                 String             @id @default(uuid()) @db.Uuid
  accountId          String             @db.Uuid
  societyId          String             @db.Uuid
  name               String             @db.VarChar(100)
  phoneNumber        String             @db.VarChar(16)
  ratePerTaskPaise   Int                @default(0)
  status             SocietyWasherStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society            Society            @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  assignments        SocietyWasherAssignment[]
  attendance         SocietyAttendance[]
  deductions         SocietyWasherDeduction[]

  @@unique([id, societyId, accountId])
  @@unique([societyId, accountId, phoneNumber])
  @@index([accountId, societyId, status, name])
}

model SocietyVehicle {
  id                           String        @id @default(uuid()) @db.Uuid
  accountId                    String        @db.Uuid
  societyId                    String        @db.Uuid
  residentId                   String        @db.Uuid
  type                         VehicleType
  registrationNumber           String        @db.VarChar(32)
  registrationNumberNormalized String        @db.VarChar(32)
  monthlyRatePaise             Int
  status                       VehicleStatus @default(ACTIVE)
  createdAt                    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime      @updatedAt @db.Timestamptz(6)
  account                      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society                      Society       @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  resident                     SocietyResident @relation(fields: [residentId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  assignments                  SocietyWasherAssignment[]
  schedules                    SocietyWashSchedule[]
  tasks                        SocietyWashTask[]
  extraWork                    SocietyExtraWork[]

  @@unique([id, accountId, societyId])
  @@unique([id, residentId, societyId, accountId])
  @@unique([accountId, registrationNumberNormalized])
  @@index([accountId, societyId, residentId, status])
}

model SocietyWasherAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  accountId String        @db.Uuid
  societyId String        @db.Uuid
  vehicleId String        @db.Uuid
  washerId  String        @db.Uuid
  startsAt  DateTime      @db.Date
  endsAt    DateTime?     @db.Date
  assignedBy String       @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society   Society       @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicle   SocietyVehicle @relation(fields: [vehicleId, accountId, societyId], references: [id, accountId, societyId], onDelete: NoAction)
  washer    SocietyWasher @relation(fields: [washerId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  tasks     SocietyWashTask[]

  @@unique([id, accountId, vehicleId, washerId])
  @@index([accountId, societyId, vehicleId, endsAt])
  @@index([accountId, societyId, washerId, startsAt])
}

model SocietyWashSchedule {
  id            String                    @id @default(uuid()) @db.Uuid
  accountId     String                    @db.Uuid
  societyId     String                    @db.Uuid
  vehicleId     String                    @db.Uuid
  activity      SocietyTaskActivity
  frequency     ScheduleFrequency
  weekdays      Int[]                     @default([])
  effectiveFrom DateTime                  @db.Date
  effectiveTo   DateTime?                 @db.Date
  status        SocietyWashScheduleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(6)
  account       Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society       Society                   @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicle       SocietyVehicle            @relation(fields: [vehicleId, accountId, societyId], references: [id, accountId, societyId], onDelete: NoAction)
  tasks         SocietyWashTask[]

  @@unique([vehicleId, activity])
  @@unique([id, accountId, vehicleId, activity])
  @@index([accountId, societyId, vehicleId, status])
  @@index([accountId, status, effectiveFrom, effectiveTo])
}

model SocietyAttendance {
  id        String                  @id @default(uuid()) @db.Uuid
  accountId String                  @db.Uuid
  societyId String                  @db.Uuid
  washerId  String                  @db.Uuid
  workDate  DateTime                @db.Date
  status    SocietyAttendanceStatus
  note      String?                 @db.VarChar(500)
  recordedBy String                 @db.Uuid
  createdAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                @updatedAt @db.Timestamptz(6)
  account   Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society   Society                 @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  washer    SocietyWasher           @relation(fields: [washerId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)

  @@unique([washerId, workDate])
  @@index([accountId, societyId, workDate])
}

model SocietyWashTask {
  id                  String              @id @default(uuid()) @db.Uuid
  accountId           String              @db.Uuid
  societyId           String              @db.Uuid
  vehicleId           String              @db.Uuid
  scheduleId          String?             @db.Uuid
  assignmentId        String?             @db.Uuid
  washerId            String?             @db.Uuid
  activity            SocietyTaskActivity @default(WASH)
  taskDate            DateTime            @db.Date
  status              SocietyTaskStatus   @default(SCHEDULED)
  completedAt         DateTime?           @db.Timestamptz(6)
  earningRatePaise    Int?
  note                String?             @db.VarChar(500)
  completedBy         String?             @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)
  account             Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society             Society             @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicle             SocietyVehicle      @relation(fields: [vehicleId, accountId, societyId], references: [id, accountId, societyId], onDelete: NoAction)
  schedule            SocietyWashSchedule? @relation(fields: [scheduleId, accountId, vehicleId, activity], references: [id, accountId, vehicleId, activity], onDelete: NoAction)
  assignment          SocietyWasherAssignment? @relation(fields: [assignmentId, accountId, vehicleId, washerId], references: [id, accountId, vehicleId, washerId], onDelete: NoAction)

  @@unique([vehicleId, taskDate, activity])
  @@index([accountId, societyId, taskDate, status])
  @@index([accountId, societyId, washerId, taskDate])
}

model SocietyInvoice {
  id            String              @id @default(uuid()) @db.Uuid
  accountId     String              @db.Uuid
  societyId     String              @db.Uuid
  residentId    String              @db.Uuid
  monthStart    DateTime            @db.Date
  dueDate       DateTime            @db.Date
  totalPaise    Int
  status        SocietyInvoiceStatus @default(ISSUED)
  createdBy     String              @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society       Society             @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  resident      SocietyResident     @relation(fields: [residentId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  lines         SocietyInvoiceLine[]
  payments      SocietyPayment[]
  reminders     SocietyPaymentReminder[]

  @@unique([residentId, monthStart])
  @@unique([id, accountId])
  @@index([accountId, societyId, monthStart, status])
}

model SocietyInvoiceLine {
  id              String        @id @default(uuid()) @db.Uuid
  accountId       String        @db.Uuid
  invoiceId       String        @db.Uuid
  vehicleId       String?       @db.Uuid
  description     String        @db.VarChar(180)
  amountPaise     Int
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  invoice         SocietyInvoice @relation(fields: [invoiceId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([invoiceId, vehicleId])
  @@index([accountId, invoiceId])
}

model SocietyPayment {
  id          String               @id @default(uuid()) @db.Uuid
  accountId   String               @db.Uuid
  invoiceId   String               @db.Uuid
  amountPaise Int
  method      SocietyPaymentMethod
  reference   String?              @db.VarChar(120)
  note        String?              @db.VarChar(500)
  recordedBy  String               @db.Uuid
  receivedAt  DateTime             @default(now()) @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice     SocietyInvoice       @relation(fields: [invoiceId, accountId], references: [id, accountId], onDelete: NoAction)

  @@index([accountId, invoiceId, receivedAt])
}

model SocietyPaymentReminder {
  id          String         @id @default(uuid()) @db.Uuid
  accountId   String         @db.Uuid
  invoiceId   String         @db.Uuid
  note        String?        @db.VarChar(500)
  createdBy   String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  account     Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice     SocietyInvoice @relation(fields: [invoiceId, accountId], references: [id, accountId], onDelete: NoAction)

  @@index([accountId, invoiceId, createdAt])
}

model SocietyWasherDeduction {
  id          String               @id @default(uuid()) @db.Uuid
  accountId   String               @db.Uuid
  societyId   String               @db.Uuid
  washerId    String               @db.Uuid
  amountPaise Int
  reason      String               @db.VarChar(500)
  status      SocietyDeductionStatus @default(PENDING)
  decisionReason String?             @db.VarChar(500)
  requestedBy String               @db.Uuid
  decidedBy   String?              @db.Uuid
  decidedAt   DateTime?            @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society     Society              @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  washer      SocietyWasher        @relation(fields: [washerId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)

  @@index([accountId, societyId, washerId, status])
}

model SocietyExtraWork {
  id                    String                 @id @default(uuid()) @db.Uuid
  accountId             String                 @db.Uuid
  societyId             String                 @db.Uuid
  residentId            String                 @db.Uuid
  vehicleId             String                 @db.Uuid
  description           String                 @db.VarChar(180)
  amountPaise           Int
  residentApproverName  String                 @db.VarChar(100)
  consentNote           String                 @db.VarChar(500)
  status                SocietyExtraWorkStatus @default(PENDING)
  decisionReason        String?                @db.VarChar(500)
  requestedBy           String                 @db.Uuid
  decidedBy             String?                @db.Uuid
  decidedAt             DateTime?              @db.Timestamptz(6)
  workDate              DateTime               @db.Date
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society               Society                @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  resident              SocietyResident        @relation(fields: [residentId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  vehicle               SocietyVehicle         @relation(fields: [vehicleId, residentId, societyId, accountId], references: [id, residentId, societyId, accountId], onDelete: NoAction)

  @@index([accountId, societyId, status, workDate])
}

model RoleProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  accountId   String?   @db.Uuid
  role        UserRole
  displayName String    @db.VarChar(80)
  profileData Json      @default("{}")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([id, userId])
  @@unique([userId, role])
  @@index([accountId, role])
}

model Session {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  roleProfileId    String      @db.Uuid
  accountId        String?     @db.Uuid
  refreshTokenHash String      @unique @db.Char(64)
  expiresAt        DateTime    @db.Timestamptz(6)
  revokedAt        DateTime?   @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleProfile      RoleProfile @relation(fields: [roleProfileId, userId], references: [id, userId], onDelete: Cascade)
  account          Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([accountId])
  @@index([expiresAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  accountId String?  @db.Uuid
  action    String   @db.VarChar(80)
  details   Json?
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

model MarketplaceProfile {
  id                 String                        @id @default(uuid()) @db.Uuid
  accountId          String                        @unique @db.Uuid
  businessName       String                        @db.VarChar(120)
  description        String?                       @db.VarChar(1000)
  category           MarketplaceCategory
  contactPhone       String                        @db.VarChar(32)
  contactEmail       String?                       @db.VarChar(254)
  addressLine        String?                       @db.VarChar(240)
  city               String?                       @db.VarChar(100)
  postalCode         String?                       @db.VarChar(24)
  latitude           Float?
  longitude          Float?
  serviceRadiusKm    Int?
  serviceAreas       String[]                      @default([])
  supportedVehicleTypes VehicleType[]
  operatingHours     Json                          @default("{}")
  logoUrl            String?                       @db.VarChar(2048)
  galleryUrls        String[]                      @default([])
  verificationStatus MarketplaceVerificationStatus @default(PENDING)
  createdAt          DateTime                      @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @db.Timestamptz(6)
  account            Account                       @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([city])
}

model MarketplaceService {
  id              String                     @id @default(uuid()) @db.Uuid
  accountId       String                     @db.Uuid
  name            String                     @db.VarChar(120)
  description     String?                    @db.VarChar(1000)
  category        MarketplaceServiceCategory
  vehicleTypes    VehicleType[]
  pricePaise      Int
  durationMinutes Int
  status          MarketplaceServiceStatus   @default(ACTIVE)
  inclusions      String[]                   @default([])
  exclusions      String[]                   @default([])
  terms           String?                    @db.VarChar(2000)
  serviceAreas    String[]                   @default([])
  version         Int                        @default(1)
  createdAt       DateTime                   @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime                   @updatedAt @db.Timestamptz(6)
  archivedAt      DateTime?                  @db.Timestamptz(6)
  account         Account                    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookings        MarketplaceBooking[]

  @@unique([id, accountId])
  @@index([accountId, status, createdAt])
  @@index([status, category])
}

model MarketplaceStaff {
  id          String               @id @default(uuid()) @db.Uuid
  accountId   String               @db.Uuid
  name        String               @db.VarChar(100)
  phoneNumber String?              @db.VarChar(32)
  skills      String[]             @default([])
  available   Boolean              @default(true)
  active      Boolean              @default(true)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime             @updatedAt @db.Timestamptz(6)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  bookings    MarketplaceBooking[]

  @@unique([id, accountId])
  @@index([accountId, active])
}

model MarketplaceBooking {
  id                       String                   @id @default(uuid()) @db.Uuid
  ownerAccountId           String                   @db.Uuid
  vendorAccountId          String                   @db.Uuid
  vehicleId                String                   @db.Uuid
  serviceId                String                   @db.Uuid
  staffId                  String?                  @db.Uuid
  idempotencyKey           String                   @db.VarChar(80)
  status                   MarketplaceBookingStatus @default(REQUESTED)
  vehicleRegistration      String                   @db.VarChar(32)
  vehicleType              VehicleType
  vehicleLabel             String?                  @db.VarChar(160)
  serviceName              String                   @db.VarChar(120)
  serviceDescription       String?                  @db.VarChar(1000)
  serviceCategory          MarketplaceServiceCategory
  serviceInclusions        String[]                 @default([])
  serviceExclusions        String[]                 @default([])
  serviceTerms             String?                  @db.VarChar(2000)
  servicePricePaise        Int
  serviceDurationMinutes   Int
  serviceVersion           Int
  windowStart              DateTime                 @db.Timestamptz(6)
  windowEnd                DateTime                 @db.Timestamptz(6)
  serviceLocation          String                   @db.VarChar(240)
  accessNotes              String?                  @db.VarChar(500)
  rejectionReason          String?                  @db.VarChar(500)
  completionNotes          String?                  @db.VarChar(1000)
  completionEvidenceUrls   String[]                 @default([])
  disputeReason            String?                  @db.VarChar(1000)
  createdAt                DateTime                 @default(now()) @db.Timestamptz(6)
  updatedAt                DateTime                 @updatedAt @db.Timestamptz(6)
  acceptedAt               DateTime?                @db.Timestamptz(6)
  startedAt                DateTime?                @db.Timestamptz(6)
  completionReportedAt     DateTime?                @db.Timestamptz(6)
  customerRespondedAt      DateTime?                @db.Timestamptz(6)
  settledAt                DateTime?                @db.Timestamptz(6)
  closedAt                 DateTime?                @db.Timestamptz(6)
  ownerAccount             Account                  @relation("MarketplaceBookingOwner", fields: [ownerAccountId], references: [id], onDelete: NoAction)
  vendorAccount            Account                  @relation("MarketplaceBookingVendor", fields: [vendorAccountId], references: [id], onDelete: NoAction)
  vehicle                  Vehicle                  @relation(fields: [vehicleId, ownerAccountId], references: [id, accountId], onDelete: NoAction)
  service                  MarketplaceService       @relation(fields: [serviceId, vendorAccountId], references: [id, accountId], onDelete: NoAction)
  staff                    MarketplaceStaff?        @relation(fields: [staffId, vendorAccountId], references: [id, accountId], onDelete: NoAction)
  events                   MarketplaceBookingEvent[]
  payments                 MarketplacePayment[]
  disputes                 MarketplaceDispute[]
  settlements              MarketplaceSettlement[]
  cancellations            MarketplaceCancellation[]

  @@unique([ownerAccountId, idempotencyKey])
  @@unique([id, vendorAccountId])
  @@unique([id, ownerAccountId])
  @@index([vendorAccountId, status, windowStart])
  @@index([ownerAccountId, status, createdAt])
  @@index([staffId])
}

model MarketplaceBookingEvent {
  id              String                    @id @default(uuid()) @db.Uuid
  bookingId       String                    @db.Uuid
  vendorAccountId String                    @db.Uuid
  actorId         String                    @db.Uuid
  actorRole       UserRole
  kind            String                    @db.VarChar(40)
  fromStatus      MarketplaceBookingStatus?
  toStatus        MarketplaceBookingStatus?
  note            String?                   @db.VarChar(1000)
  details         Json?
  createdAt       DateTime                  @default(now()) @db.Timestamptz(6)
  booking         MarketplaceBooking        @relation(fields: [bookingId, vendorAccountId], references: [id, vendorAccountId], onDelete: NoAction)

  @@index([bookingId, createdAt])
}

model MarketplacePayment {
  id              String                   @id @default(uuid()) @db.Uuid
  bookingId       String                   @db.Uuid
  vendorAccountId String                   @db.Uuid
  amountPaise     Int
  method          MarketplacePaymentMethod
  reference       String?                  @db.VarChar(120)
  note            String?                  @db.VarChar(500)
  status          MarketplacePaymentStatus @default(RECORDED_UNVERIFIED)
  recordedBy      String                   @db.Uuid
  currency        String                   @default("INR") @db.Char(3)
  idempotencyKey  String?                  @db.VarChar(80)
  verifiedAt      DateTime?                @db.Timestamptz(6)
  verifiedBy      String?                  @db.Uuid
  verificationSource   String?             @db.VarChar(40)
  verificationEvidence Json?
  failedAt        DateTime?                @db.Timestamptz(6)
  failedBy        String?                  @db.Uuid
  failureReason   String?                  @db.VarChar(500)
  createdAt       DateTime                 @default(now()) @db.Timestamptz(6)
  booking         MarketplaceBooking       @relation(fields: [bookingId, vendorAccountId], references: [id, vendorAccountId], onDelete: NoAction)
  refund          MarketplaceRefund?

  @@unique([bookingId, idempotencyKey])
  @@index([bookingId, createdAt])
}

model MarketplaceDispute {
  id               String                    @id @default(uuid()) @db.Uuid
  bookingId        String                    @db.Uuid
  vendorAccountId  String                    @db.Uuid
  ownerAccountId   String                    @db.Uuid
  status           MarketplaceDisputeStatus  @default(OPEN)
  category         String                    @db.VarChar(40)
  reason           String                    @db.VarChar(1000)
  description      String?                   @db.VarChar(2000)
  evidenceUrls     String[]                  @default([])
  openedBy         String                    @db.Uuid
  outcome          MarketplaceDisputeOutcome?
  resolutionRationale String?                @db.VarChar(2000)
  resolvedBy       String?                   @db.Uuid
  resolvedAt       DateTime?                 @db.Timestamptz(6)
  createdAt        DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @db.Timestamptz(6)
  booking          MarketplaceBooking        @relation(fields: [bookingId, vendorAccountId], references: [id, vendorAccountId], onDelete: NoAction)
  entries          MarketplaceDisputeEntry[]

  @@unique([id, bookingId])
  @@index([bookingId, createdAt])
  @@index([status, createdAt])
}

model MarketplaceDisputeEntry {
  id           String                      @id @default(uuid()) @db.Uuid
  disputeId    String                      @db.Uuid
  bookingId    String                      @db.Uuid
  kind         MarketplaceDisputeEntryKind
  actorId      String                      @db.Uuid
  actorRole    UserRole
  message      String                      @db.VarChar(2000)
  evidenceUrls String[]                    @default([])
  createdAt    DateTime                    @default(now()) @db.Timestamptz(6)
  dispute      MarketplaceDispute          @relation(fields: [disputeId, bookingId], references: [id, bookingId], onDelete: NoAction)

  @@index([disputeId, createdAt])
}

model MarketplaceSettlement {
  id               String             @id @default(uuid()) @db.Uuid
  bookingId        String             @unique @db.Uuid
  vendorAccountId  String             @db.Uuid
  agreedPricePaise Int
  verifiedPaidPaise Int
  settledBy        String             @db.Uuid
  note             String?            @db.VarChar(500)
  externalTransfer Boolean            @default(false)
  createdAt        DateTime           @default(now()) @db.Timestamptz(6)
  booking          MarketplaceBooking @relation(fields: [bookingId, vendorAccountId], references: [id, vendorAccountId], onDelete: NoAction)
}

model MarketplaceCancellation {
  id              String                      @id @default(uuid()) @db.Uuid
  bookingId       String                      @unique @db.Uuid
  vendorAccountId String                      @db.Uuid
  kind            MarketplaceCancellationKind
  initiatorId     String                      @db.Uuid
  initiatorRole   UserRole
  reason          String                      @db.VarChar(500)
  policyKey       String                      @db.VarChar(60)
  policyVersion   String                      @db.VarChar(20)
  feePaise        Int                         @default(0)
  fromStatus      MarketplaceBookingStatus
  unrefundedPaidPaise Int
  createdAt       DateTime                    @default(now()) @db.Timestamptz(6)
  booking         MarketplaceBooking          @relation(fields: [bookingId, vendorAccountId], references: [id, vendorAccountId], onDelete: NoAction)
}

model MarketplaceRefund {
  id               String                  @id @default(uuid()) @db.Uuid
  paymentId        String                  @unique @db.Uuid
  bookingId        String                  @db.Uuid
  amountPaise      Int
  status           MarketplaceRefundStatus @default(APPROVED_PENDING_EXTERNAL_TRANSFER)
  reason           String                  @db.VarChar(500)
  approvedBy       String                  @db.Uuid
  confirmedBy      String?                 @db.Uuid
  confirmedAt      DateTime?               @db.Timestamptz(6)
  evidenceReference String?                @db.VarChar(200)
  createdAt        DateTime                @default(now()) @db.Timestamptz(6)
  payment          MarketplacePayment      @relation(fields: [paymentId], references: [id], onDelete: NoAction)

  @@index([bookingId])
}
