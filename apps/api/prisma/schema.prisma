generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  INDEPENDENT_DETAILER
  SOCIETY_VENDOR
  MARKETPLACE_VENDOR
  SUPERADMIN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum VehicleType {
  TWO_WHEELER
  FOUR_WHEELER
  OTHER
}

enum VehicleStatus {
  ACTIVE
  INACTIVE
}

enum VehicleProviderType {
  INDEPENDENT_WASHER
  SOCIETY_VENDOR
  MARKETPLACE_VENDOR
}

enum WashActivity {
  EXTERIOR_WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum TaskActivity {
  DUSTING
  EXTERIOR_WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum ScheduleFrequency {
  DAILY
  SELECTED_DAYS
}

enum DailyTaskStatus {
  SCHEDULED
  COMPLETED
  MISSED
  UNAVAILABLE
}

enum DailyTaskException {
  VEHICLE_UNAVAILABLE
  WASH_MISSED
  DETAILER_ON_LEAVE
}

enum SocietyStatus {
  ACTIVE
  INACTIVE
}

enum SocietyWasherStatus {
  ACTIVE
  INACTIVE
}

enum SocietyAttendanceStatus {
  PRESENT
  ABSENT
  LEAVE
}

enum SocietyTaskActivity {
  WASH
  INTERIOR_CLEANING
  TYRE_POLISH
}

enum SocietyWashScheduleStatus {
  ACTIVE
  PAUSED
  STOPPED
}

enum SocietyTaskStatus {
  SCHEDULED
  COMPLETED
  MISSED
  UNAVAILABLE
}

enum SocietyInvoiceStatus {
  ISSUED
  VOID
}

enum SocietyPaymentMethod {
  CASH
  UPI
  BANK_TRANSFER
  CHEQUE
  OTHER
}

enum SocietyDeductionStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SocietyExtraWorkStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id           String        @id @default(uuid()) @db.Uuid
  email        String        @unique @db.VarChar(254)
  passwordHash String        @db.VarChar(255)
  status       UserStatus    @default(ACTIVE)
  createdAt    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(6)
  account      Account?      @relation("AccountOwner")
  profiles     RoleProfile[]
  sessions     Session[]
  auditEvents  AuditEvent[]  @relation("AuditActor")
}

model Account {
  id          String        @id @default(uuid()) @db.Uuid
  name        String        @db.VarChar(120)
  ownerId     String        @unique @db.Uuid
  createdAt   DateTime      @default(now()) @db.Timestamptz(6)
  owner       User          @relation("AccountOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  profiles    RoleProfile[]
  sessions    Session[]
  auditEvents AuditEvent[]
  vehicles    Vehicle[]
  detailerClients  DetailerClient[]
  detailerVehicles DetailerVehicle[]
  washSchedules    WashSchedule[]
  dailyTasks       DailyTask[]
  societies        Society[]
  societyResidents SocietyResident[]
  societyVehicles  SocietyVehicle[]
  societyWashers   SocietyWasher[]
  societyAssignments SocietyWasherAssignment[]
  societyWashSchedules SocietyWashSchedule[]
  societyAttendance SocietyAttendance[]
  societyTasks     SocietyWashTask[]
  societyInvoices SocietyInvoice[]
  societyPayments SocietyPayment[]
  societyReminders SocietyPaymentReminder[]
  societyDeductions SocietyWasherDeduction[]
  societyExtraWork SocietyExtraWork[]
}

model Vehicle {
  id                          String              @id @default(uuid()) @db.Uuid
  accountId                   String              @db.Uuid
  type                        VehicleType
  registrationNumber          String              @db.VarChar(32)
  registrationNumberNormalized String             @unique @db.VarChar(32)
  make                        String?             @db.VarChar(80)
  model                       String?             @db.VarChar(80)
  lengthCm                    Float?
  widthCm                     Float?
  heightCm                    Float?
  photoUrls                   String[]            @default([])
  locationName                String?             @db.VarChar(100)
  address                     String?             @db.VarChar(240)
  city                        String?             @db.VarChar(100)
  postalCode                  String?             @db.VarChar(24)
  providerType                VehicleProviderType?
  providerName                String?             @db.VarChar(120)
  assignedWasherName          String?             @db.VarChar(120)
  status                      VehicleStatus       @default(ACTIVE)
  createdAt                   DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt                   DateTime            @updatedAt @db.Timestamptz(6)
  account                     Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([id, accountId])
  @@index([accountId, status, createdAt])
}

model DetailerClient {
  id          String            @id @default(uuid()) @db.Uuid
  accountId   String            @db.Uuid
  name        String            @db.VarChar(100)
  phoneNumber String            @db.VarChar(16)
  notes       String?           @db.VarChar(500)
  status      VehicleStatus     @default(ACTIVE)
  createdAt   DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @db.Timestamptz(6)
  account     Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicles    DetailerVehicle[]

  @@unique([accountId, phoneNumber])
  @@unique([id, accountId])
  @@index([accountId, status, name])
}

model DetailerVehicle {
  id                           String          @id @default(uuid()) @db.Uuid
  accountId                    String          @db.Uuid
  clientId                     String          @db.Uuid
  type                         VehicleType
  registrationNumber           String          @db.VarChar(32)
  registrationNumberNormalized String          @db.VarChar(32)
  make                         String?         @db.VarChar(80)
  model                        String?         @db.VarChar(80)
  locationName                 String?         @db.VarChar(100)
  status                       VehicleStatus   @default(ACTIVE)
  createdAt                    DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime        @updatedAt @db.Timestamptz(6)
  account                      Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  client                       DetailerClient  @relation(fields: [clientId, accountId], references: [id, accountId], onDelete: NoAction)
  schedules                    WashSchedule[]
  tasks                        DailyTask[]

  @@unique([accountId, registrationNumberNormalized])
  @@unique([id, accountId])
  @@index([clientId, accountId])
  @@index([accountId, status])
}

model WashSchedule {
  id              String            @id @default(uuid()) @db.Uuid
  accountId       String            @db.Uuid
  vehicleId       String            @db.Uuid
  activity        WashActivity
  taskActivityKey TaskActivity
  frequency       ScheduleFrequency
  weekdays        Int[]             @default([])
  effectiveFrom   DateTime          @db.Date
  effectiveTo     DateTime?         @db.Date
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now()) @db.Timestamptz(6)
  updatedAt       DateTime          @updatedAt @db.Timestamptz(6)
  account         Account           @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicle         DetailerVehicle   @relation(fields: [vehicleId, accountId], references: [id, accountId], onDelete: NoAction)
  tasks           DailyTask[]

  @@unique([vehicleId, activity])
  @@unique([id, accountId])
  @@unique([id, accountId, vehicleId, taskActivityKey])
  @@index([accountId, isActive])
}

model DailyTask {
  id          String             @id @default(uuid()) @db.Uuid
  accountId   String             @db.Uuid
  vehicleId   String             @db.Uuid
  scheduleId  String?            @db.Uuid
  activity    TaskActivity
  taskDate    DateTime           @db.Date
  status      DailyTaskStatus    @default(SCHEDULED)
  exception   DailyTaskException?
  completedAt DateTime?          @db.Timestamptz(6)
  note        String?            @db.VarChar(500)
  createdAt   DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime           @updatedAt @db.Timestamptz(6)
  account     Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  vehicle     DetailerVehicle    @relation(fields: [vehicleId, accountId], references: [id, accountId], onDelete: NoAction)
  schedule    WashSchedule?      @relation(fields: [scheduleId, accountId, vehicleId, activity], references: [id, accountId, vehicleId, taskActivityKey], onDelete: NoAction)

  @@unique([vehicleId, taskDate, activity])
  @@index([accountId, taskDate])
}

model Society {
  id        String        @id @default(uuid()) @db.Uuid
  accountId String        @db.Uuid
  name      String        @db.VarChar(120)
  address   String?       @db.VarChar(240)
  status    SocietyStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @db.Timestamptz(6)
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  residents SocietyResident[]
  vehicles  SocietyVehicle[]
  washers   SocietyWasher[]
  assignments SocietyWasherAssignment[]
  schedules   SocietyWashSchedule[]
  attendance SocietyAttendance[]
  tasks     SocietyWashTask[]
  invoices  SocietyInvoice[]
  deductions SocietyWasherDeduction[]
  extraWork SocietyExtraWork[]

  @@unique([id, accountId])
  @@index([accountId, status, name])
}

model SocietyResident {
  id          String          @id @default(uuid()) @db.Uuid
  accountId   String          @db.Uuid
  societyId   String          @db.Uuid
  name        String          @db.VarChar(100)
  phoneNumber String          @db.VarChar(16)
  unit        String?         @db.VarChar(40)
  email       String?         @db.VarChar(254)
  status      VehicleStatus   @default(ACTIVE)
  createdAt   DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @db.Timestamptz(6)
  account     Account         @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society     Society         @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicles    SocietyVehicle[]
  invoices    SocietyInvoice[]
  extraWork   SocietyExtraWork[]

  @@unique([id, accountId])
  @@unique([id, societyId, accountId])
  @@unique([societyId, accountId, phoneNumber])
  @@index([accountId, societyId, status, name])
}

model SocietyWasher {
  id                 String             @id @default(uuid()) @db.Uuid
  accountId          String             @db.Uuid
  societyId          String             @db.Uuid
  name               String             @db.VarChar(100)
  phoneNumber        String             @db.VarChar(16)
  ratePerTaskPaise   Int                @default(0)
  status             SocietyWasherStatus @default(ACTIVE)
  createdAt          DateTime           @default(now()) @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @db.Timestamptz(6)
  account            Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society            Society            @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  assignments        SocietyWasherAssignment[]
  attendance         SocietyAttendance[]
  deductions         SocietyWasherDeduction[]

  @@unique([id, societyId, accountId])
  @@unique([societyId, accountId, phoneNumber])
  @@index([accountId, societyId, status, name])
}

model SocietyVehicle {
  id                           String        @id @default(uuid()) @db.Uuid
  accountId                    String        @db.Uuid
  societyId                    String        @db.Uuid
  residentId                   String        @db.Uuid
  type                         VehicleType
  registrationNumber           String        @db.VarChar(32)
  registrationNumberNormalized String        @db.VarChar(32)
  monthlyRatePaise             Int
  status                       VehicleStatus @default(ACTIVE)
  createdAt                    DateTime      @default(now()) @db.Timestamptz(6)
  updatedAt                    DateTime      @updatedAt @db.Timestamptz(6)
  account                      Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society                      Society       @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  resident                     SocietyResident @relation(fields: [residentId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  assignments                  SocietyWasherAssignment[]
  schedules                    SocietyWashSchedule[]
  tasks                        SocietyWashTask[]
  extraWork                    SocietyExtraWork[]

  @@unique([id, accountId, societyId])
  @@unique([id, residentId, societyId, accountId])
  @@unique([accountId, registrationNumberNormalized])
  @@index([accountId, societyId, residentId, status])
}

model SocietyWasherAssignment {
  id        String        @id @default(uuid()) @db.Uuid
  accountId String        @db.Uuid
  societyId String        @db.Uuid
  vehicleId String        @db.Uuid
  washerId  String        @db.Uuid
  startsAt  DateTime      @db.Date
  endsAt    DateTime?     @db.Date
  assignedBy String       @db.Uuid
  createdAt DateTime      @default(now()) @db.Timestamptz(6)
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society   Society       @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicle   SocietyVehicle @relation(fields: [vehicleId, accountId, societyId], references: [id, accountId, societyId], onDelete: NoAction)
  washer    SocietyWasher @relation(fields: [washerId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  tasks     SocietyWashTask[]

  @@unique([id, accountId, vehicleId, washerId])
  @@index([accountId, societyId, vehicleId, endsAt])
  @@index([accountId, societyId, washerId, startsAt])
}

model SocietyWashSchedule {
  id            String                    @id @default(uuid()) @db.Uuid
  accountId     String                    @db.Uuid
  societyId     String                    @db.Uuid
  vehicleId     String                    @db.Uuid
  activity      SocietyTaskActivity
  frequency     ScheduleFrequency
  weekdays      Int[]                     @default([])
  effectiveFrom DateTime                  @db.Date
  effectiveTo   DateTime?                 @db.Date
  status        SocietyWashScheduleStatus @default(ACTIVE)
  createdAt     DateTime                  @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime                  @updatedAt @db.Timestamptz(6)
  account       Account                   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society       Society                   @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicle       SocietyVehicle            @relation(fields: [vehicleId, accountId, societyId], references: [id, accountId, societyId], onDelete: NoAction)
  tasks         SocietyWashTask[]

  @@unique([vehicleId, activity])
  @@unique([id, accountId, vehicleId, activity])
  @@index([accountId, societyId, vehicleId, status])
  @@index([accountId, status, effectiveFrom, effectiveTo])
}

model SocietyAttendance {
  id        String                  @id @default(uuid()) @db.Uuid
  accountId String                  @db.Uuid
  societyId String                  @db.Uuid
  washerId  String                  @db.Uuid
  workDate  DateTime                @db.Date
  status    SocietyAttendanceStatus
  note      String?                 @db.VarChar(500)
  recordedBy String                 @db.Uuid
  createdAt DateTime                @default(now()) @db.Timestamptz(6)
  updatedAt DateTime                @updatedAt @db.Timestamptz(6)
  account   Account                 @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society   Society                 @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  washer    SocietyWasher           @relation(fields: [washerId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)

  @@unique([washerId, workDate])
  @@index([accountId, societyId, workDate])
}

model SocietyWashTask {
  id                  String              @id @default(uuid()) @db.Uuid
  accountId           String              @db.Uuid
  societyId           String              @db.Uuid
  vehicleId           String              @db.Uuid
  scheduleId          String?             @db.Uuid
  assignmentId        String?             @db.Uuid
  washerId            String?             @db.Uuid
  activity            SocietyTaskActivity @default(WASH)
  taskDate            DateTime            @db.Date
  status              SocietyTaskStatus   @default(SCHEDULED)
  completedAt         DateTime?           @db.Timestamptz(6)
  earningRatePaise    Int?
  note                String?             @db.VarChar(500)
  completedBy         String?             @db.Uuid
  createdAt           DateTime            @default(now()) @db.Timestamptz(6)
  updatedAt           DateTime            @updatedAt @db.Timestamptz(6)
  account             Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society             Society             @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  vehicle             SocietyVehicle      @relation(fields: [vehicleId, accountId, societyId], references: [id, accountId, societyId], onDelete: NoAction)
  schedule            SocietyWashSchedule? @relation(fields: [scheduleId, accountId, vehicleId, activity], references: [id, accountId, vehicleId, activity], onDelete: NoAction)
  assignment          SocietyWasherAssignment? @relation(fields: [assignmentId, accountId, vehicleId, washerId], references: [id, accountId, vehicleId, washerId], onDelete: NoAction)

  @@unique([vehicleId, taskDate, activity])
  @@index([accountId, societyId, taskDate, status])
  @@index([accountId, societyId, washerId, taskDate])
}

model SocietyInvoice {
  id            String              @id @default(uuid()) @db.Uuid
  accountId     String              @db.Uuid
  societyId     String              @db.Uuid
  residentId    String              @db.Uuid
  monthStart    DateTime            @db.Date
  dueDate       DateTime            @db.Date
  totalPaise    Int
  status        SocietyInvoiceStatus @default(ISSUED)
  createdBy     String              @db.Uuid
  createdAt     DateTime            @default(now()) @db.Timestamptz(6)
  account       Account             @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society       Society             @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  resident      SocietyResident     @relation(fields: [residentId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  lines         SocietyInvoiceLine[]
  payments      SocietyPayment[]
  reminders     SocietyPaymentReminder[]

  @@unique([residentId, monthStart])
  @@unique([id, accountId])
  @@index([accountId, societyId, monthStart, status])
}

model SocietyInvoiceLine {
  id              String        @id @default(uuid()) @db.Uuid
  accountId       String        @db.Uuid
  invoiceId       String        @db.Uuid
  vehicleId       String?       @db.Uuid
  description     String        @db.VarChar(180)
  amountPaise     Int
  createdAt       DateTime      @default(now()) @db.Timestamptz(6)
  invoice         SocietyInvoice @relation(fields: [invoiceId, accountId], references: [id, accountId], onDelete: Cascade)

  @@unique([invoiceId, vehicleId])
  @@index([accountId, invoiceId])
}

model SocietyPayment {
  id          String               @id @default(uuid()) @db.Uuid
  accountId   String               @db.Uuid
  invoiceId   String               @db.Uuid
  amountPaise Int
  method      SocietyPaymentMethod
  reference   String?              @db.VarChar(120)
  note        String?              @db.VarChar(500)
  recordedBy  String               @db.Uuid
  receivedAt  DateTime             @default(now()) @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice     SocietyInvoice       @relation(fields: [invoiceId, accountId], references: [id, accountId], onDelete: NoAction)

  @@index([accountId, invoiceId, receivedAt])
}

model SocietyPaymentReminder {
  id          String         @id @default(uuid()) @db.Uuid
  accountId   String         @db.Uuid
  invoiceId   String         @db.Uuid
  note        String?        @db.VarChar(500)
  createdBy   String         @db.Uuid
  createdAt   DateTime       @default(now()) @db.Timestamptz(6)
  account     Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  invoice     SocietyInvoice @relation(fields: [invoiceId, accountId], references: [id, accountId], onDelete: NoAction)

  @@index([accountId, invoiceId, createdAt])
}

model SocietyWasherDeduction {
  id          String               @id @default(uuid()) @db.Uuid
  accountId   String               @db.Uuid
  societyId   String               @db.Uuid
  washerId    String               @db.Uuid
  amountPaise Int
  reason      String               @db.VarChar(500)
  status      SocietyDeductionStatus @default(PENDING)
  decisionReason String?             @db.VarChar(500)
  requestedBy String               @db.Uuid
  decidedBy   String?              @db.Uuid
  decidedAt   DateTime?            @db.Timestamptz(6)
  createdAt   DateTime             @default(now()) @db.Timestamptz(6)
  account     Account              @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society     Society              @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  washer      SocietyWasher        @relation(fields: [washerId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)

  @@index([accountId, societyId, washerId, status])
}

model SocietyExtraWork {
  id                    String                 @id @default(uuid()) @db.Uuid
  accountId             String                 @db.Uuid
  societyId             String                 @db.Uuid
  residentId            String                 @db.Uuid
  vehicleId             String                 @db.Uuid
  description           String                 @db.VarChar(180)
  amountPaise           Int
  residentApproverName  String                 @db.VarChar(100)
  consentNote           String                 @db.VarChar(500)
  status                SocietyExtraWorkStatus @default(PENDING)
  decisionReason        String?                @db.VarChar(500)
  requestedBy           String                 @db.Uuid
  decidedBy             String?                @db.Uuid
  decidedAt             DateTime?              @db.Timestamptz(6)
  workDate              DateTime               @db.Date
  createdAt             DateTime               @default(now()) @db.Timestamptz(6)
  account               Account                @relation(fields: [accountId], references: [id], onDelete: Cascade)
  society               Society                @relation(fields: [societyId, accountId], references: [id, accountId], onDelete: NoAction)
  resident              SocietyResident        @relation(fields: [residentId, societyId, accountId], references: [id, societyId, accountId], onDelete: NoAction)
  vehicle               SocietyVehicle         @relation(fields: [vehicleId, residentId, societyId, accountId], references: [id, residentId, societyId, accountId], onDelete: NoAction)

  @@index([accountId, societyId, status, workDate])
}

model RoleProfile {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  accountId   String?   @db.Uuid
  role        UserRole
  displayName String    @db.VarChar(80)
  profileData Json      @default("{}")
  createdAt   DateTime  @default(now()) @db.Timestamptz(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  account     Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  sessions    Session[]

  @@unique([id, userId])
  @@unique([userId, role])
  @@index([accountId, role])
}

model Session {
  id               String      @id @default(uuid()) @db.Uuid
  userId           String      @db.Uuid
  roleProfileId    String      @db.Uuid
  accountId        String?     @db.Uuid
  refreshTokenHash String      @unique @db.Char(64)
  expiresAt        DateTime    @db.Timestamptz(6)
  revokedAt        DateTime?   @db.Timestamptz(6)
  createdAt        DateTime    @default(now()) @db.Timestamptz(6)
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleProfile      RoleProfile @relation(fields: [roleProfileId, userId], references: [id, userId], onDelete: Cascade)
  account          Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([accountId])
  @@index([expiresAt])
}

model AuditEvent {
  id        String   @id @default(uuid()) @db.Uuid
  actorId   String?  @db.Uuid
  accountId String?  @db.Uuid
  action    String   @db.VarChar(80)
  details   Json?
  ipAddress String?  @db.VarChar(64)
  userAgent String?  @db.VarChar(512)
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  actor     User?    @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([accountId, createdAt])
  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
